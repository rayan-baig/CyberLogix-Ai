# ---------------------------------------------------------------------------
# CyberLogix AI — configuration
#
# Everything here is optional. With none of it set the platform runs end to
# end in dry run: alerts are composed, incidents open and escalate, and
# every delivery is recorded as not_configured rather than silently lost.
# ---------------------------------------------------------------------------

# --- Generated copy --------------------------------------------------------
# The Google GenAI SDK reads GEMINI_API_KEY automatically. Without it every
# generated message falls back to a deterministic template — degraded
# wording, never a suppressed alert.
GEMINI_API_KEY=
CYBERLOGIX_GEMINI_MODEL=gemini-2.5-flash

# --- Delivery --------------------------------------------------------------
# Unset means dry run. All three are required before anything is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Where Twilio posts a keypress so "press 1 to acknowledge" reaches
# something. Must be publicly reachable. Without it the call still goes
# out, it simply cannot be acknowledged from the handset.
PUBLIC_BASE_URL=

# --- The unattended watchdog ----------------------------------------------
# Seconds between sweeps. 0 disables the in-process loop — set that when an
# external scheduler drives POST /api/autopilot/sweep, or when running more
# than one replica, or the same incident is escalated once per replica.
CYBERLOGIX_SWEEP_SECONDS=60

# --- Compliance vault ------------------------------------------------------
# Counter-signs attestations so a recipient can confirm one was issued by
# you. Unset, the hash chain still verifies on its own and the attestation
# says plainly that it carries no signature.
CYBERLOGIX_ATTESTATION_KEY=

# --- Invoicing -------------------------------------------------------------
# Who is asking to be paid. An invoice without these is not a document a
# finance department can pay against.
CYBERLOGIX_LEGAL_NAME=CyberLogix AI
CYBERLOGIX_ADDRESS=
CYBERLOGIX_TAX_ID=
CYBERLOGIX_REMIT_TO=
CYBERLOGIX_BILLING_EMAIL=

# --- Reseller channel ------------------------------------------------------
# Gates partner administration. Unset, those endpoints are closed rather
# than open: a deployment that forgot this must not hand out the ability to
# mint resellers.
CYBERLOGIX_ADMIN_KEY=

# --- Outbound webhooks -----------------------------------------------------
# Customer-supplied webhook URLs are posted to by this server, which makes
# them a request-forgery primitive. Private destinations are refused unless
# a self-hosted deployment has a receiver on its own network.
CYBERLOGIX_ALLOW_PRIVATE_WEBHOOKS=

# --- Spend controls --------------------------------------------------------
# Per-tenant daily ceilings. A sensor stuck in a breach loop, or a leaked
# key, cannot run up an unbounded bill. Past a cap the alert still goes out
# on the deterministic template — only the spend stops. 0 means unlimited.
CYBERLOGIX_MAX_AI_CALLS_PER_DAY=200
CYBERLOGIX_MAX_SMS_PER_DAY=100
CYBERLOGIX_MAX_VOICE_CALLS_PER_DAY=30

# Unit rates for the spend estimate. List prices for capacity planning, not
# a bill — set them to what you are actually charged.
CYBERLOGIX_RATE_AI_CALL=0.0012
CYBERLOGIX_RATE_SMS=0.0079
CYBERLOGIX_RATE_VOICE_CALL=0.0140

# --- Platform --------------------------------------------------------------
CYBERLOGIX_DB_PATH=cyberlogix.db
CYBERLOGIX_ALLOWED_ORIGINS=*
PORT=8080
