# Google GenAI credentials — the SDK reads GEMINI_API_KEY automatically.
GEMINI_API_KEY=your-google-genai-api-key-here

# Optional overrides.
CYBERLOGIX_GEMINI_MODEL=gemini-2.5-flash
CYBERLOGIX_ALLOWED_ORIGINS=*
PORT=8080

# Twilio delivery. Unset means dry-run: alerts are composed but not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
