# ---------------------------------------------------------------------------
# CyberLogix AI — configuration
#
# Everything here is optional. With none of it set the platform runs end to
# end in dry run: alerts are composed, incidents open and escalate, and
# every delivery is recorded as not_configured rather than silently lost.
# ---------------------------------------------------------------------------

# --- Generated copy --------------------------------------------------------
# The Google GenAI SDK reads GEMINI_API_KEY automatically. Without it every
# generated message falls back to a deterministic template — degraded
# wording, never a suppressed alert.
GEMINI_API_KEY=
CYBERLOGIX_GEMINI_MODEL=gemini-2.5-flash

# --- Delivery --------------------------------------------------------------
# Unset means dry run. All three are required before anything is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Seconds to wait on the Twilio API before giving up on one send. The SDK
# defaults to no timeout at all, which turns a Twilio slowdown into worker
# threads that never return. Leave this set.
TWILIO_TIMEOUT_SECONDS=8

# Where Twilio posts a keypress so "press 1 to acknowledge" reaches
# something. Must be publicly reachable. Without it the call still goes
# out, it simply cannot be acknowledged from the handset.
PUBLIC_BASE_URL=

# --- The unattended watchdog ----------------------------------------------
# Seconds between sweeps. 0 disables the in-process loop — set that when an
# external scheduler drives POST /api/autopilot/sweep, or when running more
# than one replica, or the same incident is escalated once per replica.
CYBERLOGIX_SWEEP_SECONDS=60

# --- Compliance vault ------------------------------------------------------
# Counter-signs attestations so a recipient can confirm one was issued by
# you. Unset, the hash chain still verifies on its own and the attestation
# says plainly that it carries no signature.
CYBERLOGIX_ATTESTATION_KEY=

# --- Invoicing -------------------------------------------------------------
# Who is asking to be paid. An invoice without these is not a document a
# finance department can pay against.
CYBERLOGIX_LEGAL_NAME=CyberLogix AI
CYBERLOGIX_ADDRESS=
CYBERLOGIX_TAX_ID=
CYBERLOGIX_REMIT_TO=
CYBERLOGIX_BILLING_EMAIL=

# --- Reseller channel ------------------------------------------------------
# Gates partner administration. Unset, those endpoints are closed rather
# than open: a deployment that forgot this must not hand out the ability to
# mint resellers.
CYBERLOGIX_ADMIN_KEY=

# --- Outbound webhooks -----------------------------------------------------
# Customer-supplied webhook URLs are posted to by this server, which makes
# them a request-forgery primitive. Private destinations are refused unless
# a self-hosted deployment has a receiver on its own network.
CYBERLOGIX_ALLOW_PRIVATE_WEBHOOKS=

# --- Spend controls --------------------------------------------------------
# Per-tenant daily ceilings. A sensor stuck in a breach loop, or a leaked
# key, cannot run up an unbounded bill. Past a cap the alert still goes out
# on the deterministic template — only the spend stops. 0 means unlimited.
CYBERLOGIX_MAX_AI_CALLS_PER_DAY=200
CYBERLOGIX_MAX_SMS_PER_DAY=100
CYBERLOGIX_MAX_VOICE_CALLS_PER_DAY=30

# What a *trial* may spend. Separate, and much lower, because a trial is
# real cash out (Twilio, Google) against no revenue, and the sign-up door
# is public. Five sensor seats genuinely failing never reach these; a
# script trying to run up a bill does immediately.
CYBERLOGIX_TRIAL_MAX_AI_CALLS_PER_DAY=25
CYBERLOGIX_TRIAL_MAX_SMS_PER_DAY=15
CYBERLOGIX_TRIAL_MAX_VOICE_CALLS_PER_DAY=3

# Unit rates for the spend estimate. List prices for capacity planning, not
# a bill — set them to what you are actually charged.
CYBERLOGIX_RATE_AI_CALL=0.0012
CYBERLOGIX_RATE_SMS=0.0079
CYBERLOGIX_RATE_VOICE_CALL=0.0140

# --- Licence lapse ---------------------------------------------------------
# How long an estate keeps being *monitored* after its licence runs out.
# Expiry used to be a cliff: the day after a trial ended, a vaccine fridge
# reporting 75F got a 402 and nobody was told. During grace the estate is
# watched exactly as before; what it loses is reporting — benchmarks,
# attestations, exports. Past the window ingest stops, but the routes that
# let a customer pay stay open at every point.
CYBERLOGIX_LICENCE_GRACE_DAYS=14

# --- The platform operator's own credential ---------------------------------
# Gates the routes that act for the *vendor* rather than for a customer:
# issuing an invoice, recording that money arrived, voiding a document,
# minting a reseller, and running the fleet-wide billing pass.
#
# These were `require_role("owner")` — the *customer's* owner, on the other
# side of the transaction. A customer could write off their own invoice
# with one call and a made-up reference. Unset means those routes are
# closed rather than open.
CYBERLOGIX_ADMIN_KEY=

# --- Sign-up and provisioning ----------------------------------------------
# Required to provision anything above a trial through
# POST /api/licenses/tenants. Leave it unset and no paid account can be
# created at all — which is the right default: an unconfigured deployment
# should refuse to hand out Enterprise licences rather than hand them to
# everybody. Trials come through POST /api/signup and need no key.
CYBERLOGIX_PROVISIONING_KEY=

# Set to 1 only behind a proxy that *overwrites* X-Forwarded-For. The
# per-caller sign-up limit reads the header when this is on, and a header
# the deployment does not actually set is attacker-controlled — so turning
# this on in front of the wrong proxy removes the limit rather than fixing
# it. The total ceiling applies either way.
CYBERLOGIX_TRUST_PROXY_HEADER=

# --- Outbound email ---------------------------------------------------------
# The transport the money engine runs on. Without SMTP_HOST and MAIL_FROM
# the collections ladder still runs, still claims each stage and still
# writes every notice down — and not one of them reaches the customer.
# That was the state of things for a long time: a full five-stage dunning
# process the debtor could not see.
#
# Port 465 is treated as implicit TLS; anything else uses STARTTLS unless
# SMTP_STARTTLS=0. Leave SMTP_USERNAME empty for a relay that authenticates
# by IP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_TIMEOUT_SECONDS=20

# Who the mail comes from. MAIL_FROM must be an address the sending domain
# is allowed to use, or the notices will be delivered straight to spam and
# the effect is the same as not sending them.
MAIL_FROM=
MAIL_FROM_NAME=CyberLogix AI
MAIL_REPLY_TO=

# Signs the unsubscribe links so that one customer cannot unsubscribe
# another. Generated and persisted on first use if left unset; set it
# explicitly when running more than one instance, or links minted by one
# will be rejected by the next.
CYBERLOGIX_MAIL_SECRET=

# A hosted payment page, if there is one. Alongside CYBERLOGIX_REMIT_TO
# in the Invoicing section above, this is what an invoice notice tells the
# customer to do; with neither set, every notice that goes out says the
# payment details are not configured — honest, and still no way to
# collect money.
CYBERLOGIX_PAY_URL=

# Where the daily operator digest goes: what was billed, what arrived,
# who needs a call, and anything about the system itself that is quietly
# broken. Unset, it is not sent — and the book then only exists in a
# browser somebody has to remember to open.
CYBERLOGIX_OPERATOR_EMAIL=

# --- Platform --------------------------------------------------------------
CYBERLOGIX_DB_PATH=cyberlogix.db
CYBERLOGIX_ALLOWED_ORIGINS=*
PORT=8080
